# Netlify 缓存策略（放到发布根目录即可生效）
# 单字笔画 JSON 内容不会变，按一年 immutable 缓存
/data/chars/*
  Cache-Control: public, max-age=31536000, immutable

# 码表、字根表、拼音表：随版本更新，缓存一天
/data/*.js
  Cache-Control: public, max-age=86400

# 打包后的应用脚本：随页面发布更新，缓存一小时
/dist/app.js
  Cache-Control: public, max-age=3600

# 页面本体：短缓存，保证改动立刻可见
/*.html
  Cache-Control: public, max-age=300
