# Netlify 缓存策略（放到发布根目录即可生效）
# 单字笔画 JSON 内容不会变，按一年 immutable 缓存
/data/chars/*
  Cache-Control: public, max-age=31536000, immutable

# 码表、字根表、拼音表：随版本更新，缓存一天
/data/*.js
  Cache-Control: public, max-age=86400

# 应用脚本与页面：改动要立刻可见，只缓存 60 秒
/dist/app.js
  Cache-Control: public, max-age=60, must-revalidate

/*.html
  Cache-Control: public, max-age=60, must-revalidate
